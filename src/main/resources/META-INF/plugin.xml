<idea-plugin>
    <id>com.mlnet.builder</id>
    <name>ML.NET Builder</name>
    <vendor email="mlnet-builder@example.com" url="https://github.com/mlnet-builder">ML.NET Builder</vendor>

    <description><![CDATA[
        <h2>ML.NET Builder for JetBrains Rider</h2>
        <p>Build, train, and deploy custom ML.NET machine learning models directly within JetBrains Rider.
        Provides a Visual Studio Model Builder-compatible wizard experience.</p>
        <ul>
            <li><b>Step-by-step wizard</b> — guided workflow for model creation</li>
            <li><b>AutoML training</b> — automatically finds the best algorithm and hyperparameters</li>
            <li><b>Code generation</b> — generates ready-to-use C# consumption and training code</li>
            <li><b>Scenario support</b> — Classification, Regression, Recommendation, Image Classification, Forecasting, Anomaly Detection</li>
            <li><b>.mbconfig compatibility</b> — fully compatible with Visual Studio's ML.NET Model Builder</li>
        </ul>
    ]]></description>

    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.modules.rider</depends>

    <extensions defaultExtensionNs="com.intellij">
        <!-- Tool Window -->
        <toolWindow id="ML.NET Builder"
                    factoryClass="com.mlnet.builder.ui.MLNetToolWindowFactory"
                    anchor="bottom"
                    secondary="false"
                    icon="/icons/mlnet-logo.svg"/>

        <!-- Settings -->
        <applicationConfigurable
                parentId="tools"
                instance="com.mlnet.builder.settings.MLNetSettingsConfigurable"
                id="com.mlnet.builder.settings"
                displayName="ML.NET Builder"/>

        <applicationService
                serviceImplementation="com.mlnet.builder.settings.MLNetSettings"/>

        <!-- File Type -->
        <fileType
                name="MbConfig"
                implementationClass="com.mlnet.builder.filetype.MbConfigFileType"
                fieldName="INSTANCE"
                language="TEXT"
                extensions="mbconfig"/>

        <!-- Project Service -->
        <projectService
                serviceImplementation="com.mlnet.builder.services.MbConfigService"/>
        <projectService
                serviceImplementation="com.mlnet.builder.services.MLNetCliService"/>
        <projectService
                serviceImplementation="com.mlnet.builder.services.DataService"/>
        <projectService
                serviceImplementation="com.mlnet.builder.services.CodeGenerationService"/>
        <projectService
                serviceImplementation="com.mlnet.builder.services.DotNetSdkService"/>

        <!-- Notifications -->
        <notificationGroup id="ML.NET Builder"
                           displayType="BALLOON"
                           key="notification.group.mlnet"/>
    </extensions>

    <actions>
        <!-- Add ML Model Action -->
        <action id="MLNet.AddModel"
                class="com.mlnet.builder.actions.AddMLModelAction"
                text="Machine Learning Model (ML.NET)"
                description="Add a new ML.NET machine learning model to the project"
                icon="/icons/mlnet-logo.svg">
            <add-to-group group-id="NewGroup" anchor="last"/>
        </action>

        <!-- Open mbconfig Action -->
        <action id="MLNet.OpenMbConfig"
                class="com.mlnet.builder.actions.OpenMbConfigAction"
                text="Open in ML.NET Builder"
                description="Open this .mbconfig file in ML.NET Builder wizard">
            <add-to-group group-id="ProjectViewPopupMenu" anchor="after" relative-to-action="EditSource"/>
        </action>
    </actions>
</idea-plugin>
